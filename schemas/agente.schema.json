{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canvas-vivo-atdg/agente.schema.json",
  "title": "Registro de agente moldado por processo — Canvas Vivo ATDG",
  "type": "object",
  "required": ["id", "codigo", "pop_id", "nome", "arquivo", "versao_diretrizes", "modelo", "criado_em", "atualizado_em"],
  "properties": {
    "id": {"type": "string", "pattern": "^agente-pop-[a-z0-9-]+-[0-9]{2}$"},
    "codigo": {"type": "string"},
    "pop_id": {"type": "string"},
    "nome": {"type": "string"},
    "setor_codigo": {"type": "string"},
    "arquivo": {"type": "string"},
    "versao_diretrizes": {"type": "string"},
    "versao_pop": {"type": "string"},
    "modelo": {"type": "string"},
    "origem": {"type": "string", "enum": ["claude-code", "app", "script"]},
    "criado_em": {"type": "string"},
    "atualizado_em": {"type": "string"}
  }
}
